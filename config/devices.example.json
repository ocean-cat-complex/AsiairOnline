{
  "project": {
    "timezone": "Asia/Shanghai",
    "destination_root": "state/backups",
    "logs_dir": "logs",
    "state_dir": "state",
    "lock_file": "state/backup.lock",
    "default_device": "asiair-a",
    "private_path_prefixes": [
      "state/backups"
    ]
  },
  "backup": {
    "dry_run_default": true,
    "copy_empty_dirs": true,
    "smb_port": 445,
    "exclude_dirs": [
      "@eaDir",
      "#recycle",
      "$RECYCLE.BIN",
      "System Volume Information",
      ".Spotlight-V100",
      ".Trashes",
      ".fseventsd"
    ],
    "exclude_files": [
      "Thumbs.db",
      ".DS_Store",
      "._*"
    ],
    "source_roots": [
      {
        "label": "EMMC Images",
        "path_template": "/Volumes/{name}/EMMC Images",
        "enabled": true
      }
    ]
  },
  "devices": [
    {
      "name": "asiair-a",
      "ip": "192.168.8.101",
      "enabled": true,
      "endpoints": [
        {
          "label": "wired",
          "kind": "ethernet",
          "ip": "192.168.8.101",
          "priority": 0
        },
        {
          "label": "wifi-bridge",
          "kind": "wireless_bridge",
          "ip": "192.168.8.102",
          "priority": 10
        }
      ]
    },
    {
      "name": "asiair-b",
      "ip": "192.168.8.111",
      "enabled": true,
      "endpoints": [
        {
          "label": "wired",
          "kind": "ethernet",
          "ip": "192.168.8.111",
          "priority": 0
        },
        {
          "label": "wifi-bridge",
          "kind": "wireless_bridge",
          "ip": "192.168.8.112",
          "priority": 10
        }
      ],
      "source_roots": [
        {
          "label": "EMMC Images",
          "path_template": "/Volumes/{name}/EMMC Images",
          "enabled": true
        },
        {
          "label": "TF Images",
          "path_template": "/Volumes/{name}/TF Images",
          "enabled": true
        },
        {
          "label": "Udisk Images",
          "path_template": "/Volumes/{name}/Udisk Images",
          "enabled": true
        }
      ]
    },
    {
      "name": "asiair-c",
      "ip": "192.168.8.121",
      "enabled": true,
      "endpoints": [
        {
          "label": "wired",
          "kind": "ethernet",
          "ip": "192.168.8.121",
          "priority": 0
        },
        {
          "label": "wifi-bridge",
          "kind": "wireless_bridge",
          "ip": "192.168.8.122",
          "priority": 10
        }
      ]
    }
  ]
}
